---
// Icon-only social links driven entirely by SOCIAL_LINKS in src/consts.ts.
// Icons are inline SVG strokes (no icon font, no CDN) and inherit
// `currentColor`, so they follow the light/dark palettes automatically.
import { SOCIAL_LINKS, type SocialIcon } from "../consts";
import { t } from "../i18n";
import { withBase } from "../lib/url";

const ICONS: Record<SocialIcon, string> = {
  email:
    '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6l9 -6"/>',
  github:
    '<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>',
  linkedin:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 0 0 -4 0"/>',
  rss: '<circle cx="5" cy="19" r="1"/><path d="M4 4a16 16 0 0 1 16 16"/><path d="M4 11a9 9 0 0 1 9 9"/>',
  x: '<path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>',
};

const isInternal = (href: string) => href.startsWith("/");
---

{SOCIAL_LINKS.length > 0 && (
  <ul aria-label={t("social.label")} class="social-links">
    {SOCIAL_LINKS.map((link) => (
      <li>
        <a
          aria-label={link.label}
          href={isInternal(link.href) ? withBase(link.href) : link.href}
          {...(isInternal(link.href) || link.href.startsWith("mailto:")
            ? {}
            : { rel: "noopener noreferrer", target: "_blank" })}
        >
          <svg
            aria-hidden="true"
            fill="none"
            height="18"
            set:html={ICONS[link.icon]}
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            width="18"
          />
        </a>
      </li>
    ))}
  </ul>
)}

---
// Renders schema.org JSON-LD. Pass one schema object or an array of them;
// use with `slot="head"` so the script lands inside <head>.
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>

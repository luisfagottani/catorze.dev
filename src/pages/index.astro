---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import StructuredData from "../components/structured-data.astro";
import { SITE } from "../consts";
import { formatDate, t } from "../i18n";
import BaseLayout from "../layouts/base-layout.astro";
import { withBase } from "../lib/url";

const works = (await getCollection("works"))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  description: SITE.description,
  name: SITE.title,
  url: new URL(withBase("/"), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData schema={websiteSchema} slot="head" />
  <section class="hero section">
    <p class="eyebrow">til / notas / demos</p>
    <h1>catorze.fyi</h1>
    <p class="lead">
      Vamos ver se vai virar blog, um notebook digital, ou onde eu vou tentar
      explicar algo que eu aprendi, pra entender mesmo se eu aprendi. Muita
      coisa aqui está com texto default, desconfie de um texto polite demais..
      ainda vai ser atualizado. Abraaax, FYI!
    </p>
    <nav aria-label={t("home.primaryLinks")} class="action-row">
      <a class="button" href={withBase("/blog/")}>{t("home.readNotes")}</a>
      <a class="text-link" href={withBase("/blog/")}>{t("home.allPosts")}</a>
    </nav>
  </section>

  <section aria-label={t("home.overviewLabel")} class="section split-overview">
    <div>
      <p class="eyebrow">Jardim</p>
      <h2>Notas, labs e coisas em andamento.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Notas</h3>
        <p>
          Posts curtos e TILs quando algo gruda — inclusive demos de animation
          no meio do texto.
        </p>
      </article>
      <article>
        <h3>Works</h3>
        <p>Cases e projetos, quando tiver algo sólido pra mostrar.</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="latest-works" class="section index-feed">
    <div class="section-heading">
      <p class="eyebrow">{t("home.latestWorksEyebrow")}</p>
      <h2 id="latest-works">Works.</h2>
      <a class="text-link" href={withBase("/works/")}>{t("home.allWorks")}</a>
    </div>

    {works.length > 0 ? (
      <div class="highlight-grid">
        {works.map((work) => (
          <article class="highlight-card">
            {work.data.thumbnail ? (
              <Image
                alt=""
                height={480}
                loading="lazy"
                src={work.data.thumbnail}
                width={720}
              />
            ) : null}
            <div>
              <p class="meta">{formatDate(work.data.publishDate, "short")}</p>
              <h3>
                <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
              </h3>
              <p>{work.data.description}</p>
              {work.data.tech.length > 0 && (
                <ul
                  aria-label={t("home.workTech", { title: work.data.title })}
                  class="tag-list"
                >
                  {work.data.tech.slice(0, 4).map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state compact">
        <p set:html={t("home.worksEmpty")} />
      </div>
    )}
  </section>

  <section aria-labelledby="latest-notes" class="section index-feed">
    <div class="section-heading">
      <p class="eyebrow">{t("home.latestBlogEyebrow")}</p>
      <h2 id="latest-notes">Notas de campo.</h2>
      <a class="text-link" href={withBase("/blog/")}>{t("home.allPosts")}</a>
    </div>

    {posts.length > 0 ? (
      <div class="note-list">
        {posts.map((post) => (
          <article class="note-row">
            {post.data.heroImage ? (
              <Image
                alt=""
                height={220}
                loading="lazy"
                src={post.data.heroImage}
                width={320}
              />
            ) : null}
            <div>
              <p class="meta">{formatDate(post.data.publishDate, "short")}</p>
              <h3>
                <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state compact">
        <p set:html={t("home.postsEmpty")} />
      </div>
    )}
  </section>
</BaseLayout>
